rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // uploads folder - public write, authenticated read
    match /uploads/{allPaths=**} {
      allow write: if true;
      allow read: if true;
    }

    // products folder - public read, no write
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // all other folders - authenticated only
    match /{allPaths=**} {
      allow read, write: if true;//request.auth != null;
    }
  }
}